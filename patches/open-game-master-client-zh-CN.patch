+
+export function shellUsesChinese(): boolean {
+  const saved = window.localStorage.getItem("odm.locale");
+  if (saved === "zh-CN") return true;
+  if (saved === "en" || saved === "fr") return false;
+  const current = document.documentElement.lang.toLowerCase();
+  if (current === "zh-cn") return true;
+  if (current === "fr" || current.startsWith("fr-")) return false;
+  for (const raw of navigator.languages ?? [navigator.language]) {
+    const tag = raw.toLowerCase();
+    const language = tag.split("-")[0];
+    if (language === "en" || language === "fr") return false;
+    if (language === "zh") {
+      try {
+        if (new Intl.Locale(tag).maximize().script === "Hans") return true;
+      } catch {
+        // Ignore malformed language tags.
+      }
+    }
+  }
+  return false;
+}
+
+export function shellText(english: string): string {
+  return shellUsesChinese() && Object.hasOwn(translations, english) ? translations[english] ?? english : english;
+}
