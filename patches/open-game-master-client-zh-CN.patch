diff --git a/tests/shell-language.test.mjs b/tests/shell-language.test.mjs
new file mode 100644
index 0000000..fe470ed
--- /dev/null
+++ b/tests/shell-language.test.mjs
@@ -0,0 +1,30 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { shellText, shellUsesChinese } from "../src/renderer/shell-language.ts";
+
+test("the desktop shell follows the device language and explicit preferences", () => {
+  let saved = null;
+  const element = { lang: "en-US" };
+  const browser = { languages: ["zh-Hans-CN", "en-US"] };
+  globalThis.window = { localStorage: { getItem: () => saved } };
+  globalThis.document = { documentElement: element };
+  Object.defineProperty(globalThis, "navigator", { value: browser, configurable: true });
+
+  assert.equal(shellText("Share on this Wi-Fi"), "在当前 Wi-Fi 上分享");
+  assert.equal(shellText("A campaign name"), "A campaign name");
+  saved = "en";
+  assert.equal(shellText("Share on this Wi-Fi"), "Share on this Wi-Fi");
+
+  saved = null;
+  element.lang = "fr-FR";
+  assert.equal(shellUsesChinese(), false);
+  saved = "zh-CN";
+  assert.equal(shellText("Settings"), "设置");
+
+  saved = null;
+  element.lang = "en-US";
+  browser.languages = ["zh-Hant", "en-US"];
+  assert.equal(shellUsesChinese(), false);
+  browser.languages = ["zh-Hant", "zh-SG"];
+  assert.equal(shellUsesChinese(), true);
+});
